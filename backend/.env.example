# =========================================================================
# Backend Environment Configuration Example
# Copy this file to .env and provide your actual secrets. NEVER commit .env!
# =========================================================================

PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sakshiclothing?retryWrites=true&w=majority

# CORS & Domain Configuration (Allowed origins separated by comma)
ALLOWED_ORIGINS=https://www.sakshiclothing.store,https://sakshiclothing.store,https://admin.sakshiclothing.store,http://localhost:5173,http://localhost:3000,http://localhost:3001
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:5000

# Authentication & JWT Secrets
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_string
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Initial Admin Bootstrap Credentials (Used for first-time admin setup)
ADMIN_EMAIL=admin@sakshiclothing.store
ADMIN_PASSWORD=replace_with_a_strong_password_minimum_12_chars
INITIAL_SUPERADMIN_EMAILS=admin@sakshiclothing.store

# Clerk Authentication (Customer Auth)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here
CLERK_WEBHOOK_SECRET=whsec_placeholder_secret_here

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@sakshiclothing.store
SMTP_PASS=placeholder_app_password
FROM_EMAIL=orders@sakshiclothing.store
FROM_NAME="Sakshi Clothing Atelier"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
