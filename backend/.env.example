# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Production MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sakshiclothing?retryWrites=true&w=majority

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
ALLOWED_ORIGINS=https://sakshiclothing.vercel.app,https://admin-sakshiclothing.vercel.app,http://localhost:5173,http://localhost:3001
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:5000

# Authentication & Session Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
COOKIE_EXPIRE=7

# Cloudinary Configuration (For product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Superadmin Provisioning (Comma-separated initial admin emails)
INITIAL_SUPERADMIN_EMAILS=admin@sakshiclothing.com
